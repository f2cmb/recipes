{% extends 'admin/admin.html.twig' %}

{% block title %}Éditer {{ recipe.title }}{% endblock %}

{% block body %}
    <h1>Éditer {{ recipe.title }}</h1>
     
    {% if recipe.thumbnail %}
    <p>
        <img src="{{ path('image_resize', {path: 'recipes/' ~ recipe.thumbnail, w: 300}) }}" alt="{{ recipe.title }}" />
    </p>
    {% endif %}

    <div class="form-wrapper">
      
        {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.thumbnailFile) }}
        {{ form_row(form.content) }}
        {{ form_row(form.duration) }}
        {{ form_row(form.regime) }}
        {{ form_row(form.category) }}
        {{ form_row(form.save) }}
        {{ form_end(form) }}

    </div>

{% endblock %}