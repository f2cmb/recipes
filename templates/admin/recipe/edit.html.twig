{% extends 'admin/admin.html.twig' %}

{% block title %}Éditer {{ recipe.title }}{% endblock %}

{% block body %}
    <h1>Éditer {{ recipe.title }}</h1>
     
    <p>
        <img src="{{ vich_uploader_asset(recipe, 'thumbnailFile') }}" alt="{{ recipe.title }}" />
    </p>

    <div class="form-wrapper">
      
        {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.thumbnailFile) }}
        {{ form_row(form.content) }}
        {{ form_row(form.duration) }}
        {{ form_row(form.regime) }}
        {{ form_row(form.category) }}
        {{ form_row(form.save) }}
        {{ form_end(form) }}

    </div>

{% endblock %}